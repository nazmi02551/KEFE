# KEFE API — Environment configuration reference
#
# Copy this file to .env (local) or inject as environment variables.
# All variables use the KEFE_ prefix.
#
# NEVER commit real secrets. Use a secret manager in production.
# Production requires KEFE_ENVIRONMENT=production + strict validation (see settings.py).

# ---------------------------------------------------------------------------
# Core runtime
# ---------------------------------------------------------------------------

# "development" (default) | "staging" | "production"
KEFE_ENVIRONMENT=development

# API metadata
KEFE_API_TITLE=KEFE API
KEFE_API_VERSION=0.23.0

# "memory" (default, for local dev/test) | "postgres" (required for production)
KEFE_PERSISTENCE_BACKEND=memory

# Required when KEFE_PERSISTENCE_BACKEND=postgres
# KEFE_DATABASE_URL=postgresql+psycopg2://kefe:kefe@localhost:5432/kefe

# ---------------------------------------------------------------------------
# Session & token security
#
# In development, insecure default secrets are used automatically.
# In production, you MUST supply strong, randomly generated secrets (>=32 bytes).
# ---------------------------------------------------------------------------

# Active key ID for session renewal tokens
# KEFE_SESSION_RENEWAL_ACTIVE_KEY_ID=primary-v1

# Minimum 32-char secret for signing session renewal tokens
# KEFE_SESSION_RENEWAL_SECRET=<generate: openssl rand -hex 32>

# Previously active keys for zero-downtime rotation (JSON dict: {key_id: secret})
# KEFE_SESSION_RENEWAL_RETAINED_KEYS={}

# Session lifetime settings (days)
KEFE_SESSION_RENEWAL_ABSOLUTE_LIFETIME_DAYS=180
KEFE_SESSION_RENEWAL_INACTIVITY_DAYS=60
KEFE_SESSION_RENEWAL_PREVIOUS_PAIR_GRACE_SECONDS=60

# Guest and account token TTL
KEFE_GUEST_TOKEN_TTL_DAYS=30
KEFE_ACCOUNT_TOKEN_TTL_DAYS=30

# Active key ID for account merge replay tokens
# KEFE_ACCOUNT_MERGE_REPLAY_ACTIVE_KEY_ID=primary-v1

# Minimum 32-char secret for signing account merge replay tokens
# KEFE_ACCOUNT_MERGE_REPLAY_SECRET=<generate: openssl rand -hex 32>

# ---------------------------------------------------------------------------
# OTP / Authentication
#
# KEFE_OTP_DELIVERY_MODE controls how one-time passwords are sent:
#   CAPTURE  — codes are captured in memory (local dev/test only)
#   DISABLED — OTP endpoint returns 503 (useful for API-only testing)
#   HTTP     — codes are sent to a real HTTP provider endpoint (required for production)
#
# Production MUST use HTTP mode with a real provider.
# ---------------------------------------------------------------------------

# "CAPTURE" (default) | "DISABLED" | "HTTP"
KEFE_OTP_DELIVERY_MODE=CAPTURE

# Required when KEFE_OTP_DELIVERY_MODE=HTTP
# KEFE_OTP_HTTP_ENDPOINT=https://api.your-sms-provider.com/v1/otp/send

# Either KEFE_OTP_HTTP_BEARER_TOKEN or KEFE_OTP_HTTP_SECRET_REF must be set for HTTP mode.
# Bearer token (static): suitable for simple providers
# KEFE_OTP_HTTP_BEARER_TOKEN=<your-provider-api-key>
# Secret ref (dynamic): for providers using key rotation (e.g., AWS Secrets Manager)
# KEFE_OTP_HTTP_SECRET_REF=arn:aws:secretsmanager:eu-central-1:123456789:secret:kefe-otp-key

# HTTP transport tuning
KEFE_OTP_HTTP_TIMEOUT_MS=3000
KEFE_OTP_HTTP_MAX_RESPONSE_BYTES=16384
KEFE_OTP_HTTP_MAX_ATTEMPTS=2

# OTP challenge and verification TTL
KEFE_OTP_CHALLENGE_TTL_MINUTES=10
KEFE_OTP_VERIFICATION_TTL_MINUTES=15
KEFE_OTP_MAX_ATTEMPTS=5

# OTP request rate guard: "AUTO" (default) | "OFF" (dev only) | "ENFORCE"
# Production MUST NOT use OFF
KEFE_OTP_REQUEST_GUARD_MODE=AUTO
KEFE_OTP_REQUEST_COOLDOWN_SECONDS=60
KEFE_OTP_REQUEST_WINDOW_SECONDS=900
KEFE_OTP_REQUEST_WINDOW_LIMIT=5

# OTP provider receipt verification (for inbound provider callbacks)
# "DISABLED" (default) | "HMAC_SHA256"
KEFE_OTP_RECEIPT_MODE=DISABLED
# KEFE_OTP_RECEIPT_SECRET_REFS={"provider-v1": "<hmac-secret>"}

# ---------------------------------------------------------------------------
# Guest admission & device integrity
# ---------------------------------------------------------------------------

KEFE_GUEST_ISSUE_RATE_LIMIT=10
KEFE_GUEST_ISSUE_RATE_WINDOW_SECONDS=60

# "OFF" | "OPTIONAL" (default) | "REQUIRED"
KEFE_DEVICE_INTEGRITY_MODE=OPTIONAL

# ---------------------------------------------------------------------------
# Provider HTTP runtime (public feed RSS/Atom capture)
#
# Required for public feed catalog activation.
# In development, DISABLED by default — no external HTTP calls are made.
# ---------------------------------------------------------------------------

# "DISABLED" (default) | "PINNED_TLS"
KEFE_PROVIDER_HTTP_RUNTIME_MODE=DISABLED

# Path to CA bundle for pinned TLS (required when PINNED_TLS)
# KEFE_PROVIDER_HTTP_CA_BUNDLE_PATH=/etc/ssl/certs/kefe-ca-bundle.pem
KEFE_PROVIDER_HTTP_DNS_MAX_ANSWERS=16

# ---------------------------------------------------------------------------
# Raw evidence storage (SourceArtifact objects)
#
# "DISABLED" (default) | "EXTERNAL_DURABLE"
# Production: requires EXTERNAL_DURABLE + an approved storage profile.
# ---------------------------------------------------------------------------

KEFE_RAW_EVIDENCE_RUNTIME_MODE=DISABLED
# KEFE_RAW_EVIDENCE_BACKEND_PROFILE_CODE=kefe-evidence-s3-v1

# ---------------------------------------------------------------------------
# Event transport (transactional outbox)
# ---------------------------------------------------------------------------

# "logging" (default — logs events, no external transport)
KEFE_EVENT_TRANSPORT=logging
KEFE_OUTBOX_BATCH_SIZE=100
KEFE_OUTBOX_LEASE_SECONDS=30
KEFE_OUTBOX_POLL_SECONDS=1.0
KEFE_OUTBOX_RETRY_BASE_SECONDS=5
KEFE_OUTBOX_RETRY_MAX_SECONDS=900
KEFE_OUTBOX_MAX_ATTEMPTS=8

# ---------------------------------------------------------------------------
# Sharing
# ---------------------------------------------------------------------------

KEFE_SHARE_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Quick-start for local development (memory backend, no external services)
# ---------------------------------------------------------------------------
#
# Run with:
#   KEFE_ENVIRONMENT=development \
#   KEFE_PERSISTENCE_BACKEND=memory \
#   KEFE_OTP_DELIVERY_MODE=CAPTURE \
#   uvicorn kefe_api.main:app --reload --port 8000
#
# Or use:
#   make api-dev
#
# To use PostgreSQL locally:
#   docker compose -f infra/local/compose.yaml up -d
#   KEFE_PERSISTENCE_BACKEND=postgres \
#   KEFE_DATABASE_URL=postgresql+psycopg2://kefe:kefe@localhost:5432/kefe \
#   uvicorn kefe_api.main:app --reload --port 8000
#
# Run migrations:
#   make db-migrate
#
# Run tests (memory, fast):
#   make api-test-fast
#
# Run tests (postgres):
#   make api-test-postgres