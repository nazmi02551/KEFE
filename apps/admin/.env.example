# KEFE Admin Studio — environment configuration reference
# Copy to .env.local for local development.

# ---------------------------------------------------------------------------
# API base URL
# ---------------------------------------------------------------------------

# Canonical KEFE API base URL. HTTPS is required outside localhost.
# Server-side Next.js route handlers use KEFE_API_BASE_URL (not exposed to browser).
# Client-side components that call the API directly use NEXT_PUBLIC_KEFE_API_BASE_URL.
NEXT_PUBLIC_KEFE_API_BASE_URL=http://localhost:8000
KEFE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Admin session
# ---------------------------------------------------------------------------

# Admin Studio reads the CSRF token from the kefe_admin_csrf cookie set by
# the API's /v1/admin/session/start endpoint. No manual configuration needed.

# ---------------------------------------------------------------------------
# Signal / Impact pipeline (internal endpoints)
# ---------------------------------------------------------------------------

# Signal pipeline compute endpoint (internal, not exposed to public)
# POST /internal/signal-pipeline/compute
# GET  /internal/signal-pipeline/signals
# GET  /internal/signal-pipeline/signals/{id}
# These endpoints are served by KEFE_API_BASE_URL above.

# ---------------------------------------------------------------------------
# Quick-start for local development
# ---------------------------------------------------------------------------
#
# 1. Start the API:
#    cd services/api && make api-dev
#
# 2. Start Admin Studio:
#    cd apps/admin && npm run dev
#
# 3. Open http://localhost:3000
#
# The Signal page (/signal) and Impact page (/impact) require
# the API to be running with at least one qualified signal / institution response.
# Use the signal pipeline endpoint to compute a test signal:
#   curl -X POST http://localhost:8000/internal/signal-pipeline/compute \
#        -H "Content-Type: application/json" \
#        -d '{"case_version_id": "22222222-2222-4222-8222-222222222222"}'