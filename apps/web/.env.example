# KEFE Web — environment configuration reference
# Copy to .env.local for local development.

# ---------------------------------------------------------------------------
# API base URLs
# ---------------------------------------------------------------------------

# Browser-visible public API base URL (server-side rendering uses KEFE_API_BASE_URL below)
NEXT_PUBLIC_KEFE_API_BASE_URL=http://localhost:8000

# Server-side API base URL (used in Server Components / Route Handlers)
KEFE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Quick-start
# ---------------------------------------------------------------------------
#
# 1. Start the KEFE API:
#    cd services/api && make api-dev
#
# 2. Start KEFE Web:
#    cd apps/web && npm run dev
#    → http://localhost:3001
#
# Pages:
#   /            — home (hero)
#   /signal      — public signal consensus cards
#   /cases       — public case list (not yet implemented)
#
# Signal consensus cards require at least one qualified signal.
# To seed test data, use the signal pipeline compute endpoint:
#   curl -X POST http://localhost:8000/internal/signal-pipeline/compute \
#        -H "Content-Type: application/json" \
#        -d '{"case_version_id": "22222222-2222-4222-8222-222222222222"}'
# Note: pipeline-generated signals have [PROVISIONAL] statements and are
# filtered from public display until editorial review completes.