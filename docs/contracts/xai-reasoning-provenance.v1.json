{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XaiReasoningProvenanceContract",
  "version": "v1",
  "contract_id": "KEFE-XAI-PROV-001",
  "capability_id": "CAP-095",
  "status": "ACCEPTED",
  "invariants": {
    "zero_black_box_opacity": true,
