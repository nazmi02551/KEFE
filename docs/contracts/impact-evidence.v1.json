{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImpactEvidenceContract",
  "version": "v1",
  "contract_id": "KEFE-IMPACT-EVIDENCE-001",
  "capability_id": "CAP-053",
  "status": "ACCEPTED",
  "invariants": {
    "artifact_hash_verified": true,
    "primary_source_provenance_enforced": true
  },
  "type": "object",
  "required": [
    "evidence_id",
    "action_id",
    "evidence_type",
    "evidence_title",
    "source_url",
    "sha256_digest",
    "verification_status"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 4
    },
    "action_id": {
      "type": "string",
      "minLength": 4
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "OFFICIAL_GAZETTE_DECREE",
        "AUDIT_EXPENDITURE_RECEIPT",
        "SENSOR_TELEMETRY_DATA",
        "THIRD_PARTY_ACADEMIC_STUDY"
      ]
    },
    "evidence_title": {
      "type": "string",
      "minLength": 5
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "sha256_digest": {
      "type": "string",
      "minLength": 16
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "PENDING_AUDIT",
        "VERIFIED_AUTHENTIC",
        "CHALLENGED_OR_INSUFFICIENT"
      ]
    }
  }
}
