{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionDeviceSecurityContract",
  "version": "v1",
  "contract_id": "KEFE-SESS-SEC-001",
  "capability_id": "CAP-087",
  "status": "ACCEPTED",
  "invariants": {
    "instant_remote_revocation_enforced": true,
    "hardware_attestation_supported": true
  },
  "type": "object",
  "required": [
    "session_id",
    "device_name",
    "client_platform",
    "trust_tier",
    "ip_country_code",
    "is_current_device"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 4
    },
    "device_name": {
      "type": "string",
      "minLength": 3
    },
    "client_platform": {
      "type": "string",
      "enum": [
        "ANDROID",
        "IOS",
        "WEB_BROWSER",
        "DESKTOP_CLIENT"
      ]
    },
    "trust_tier": {
      "type": "string",
      "enum": [
        "HARDWARE_ATTESTED_SECURE",
        "STANDARD_AUTHENTICATED",
        "UNRECOGNIZED_STALE"
      ]
    },
    "ip_country_code": {
      "type": "string",
      "minLength": 2,
      "maxLength": 2
    },
    "is_current_device": {
      "type": "boolean"
    }
  }
}
