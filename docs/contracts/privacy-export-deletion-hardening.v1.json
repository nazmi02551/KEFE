  ],
  "authority": {
    "adr": "docs/adr/0108-deterministic-privacy-export-and-deletion-hardening.md",
    "service": "services/api/src/kefe_api/modules/privacy/service.py",
    "router": "services/api/src/kefe_api/modules/privacy/router.py"
  },
  "invariants": [
    "ONE_EXISTING_SELF_SERVICE_PRIVACY_AUTHORITY",
    "ACTOR_IDENTITY_SERVER_DERIVED",
    "NO_EXPORT_PAYLOAD_PERSISTENCE",
    "NO_SECONDARY_USER_DATA_COPY",
    "ONE_APPEND_ONLY_DELETION_RECEIPT_PER_ACTOR",
