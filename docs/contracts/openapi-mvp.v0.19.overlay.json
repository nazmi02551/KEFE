    "/internal/admin/v1/community-reasons/{reason_id}/moderation": {
      "post": {
        "operationId": "moderate_reason_internal_admin_v1_community_reasons__reason_id__moderation_post",
        "parameters": [
          {
            "in": "path",
            "name": "reason_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Reason Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-KEFE-CSRF",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Kefe-Csrf"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModerateCommunityReasonRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModerateCommunityReasonResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Moderate Reason",
        "tags": [
          "Internal Admin"
        ]
      }
    },
