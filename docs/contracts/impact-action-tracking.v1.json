{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImpactActionTrackingContract",
  "version": "v1",
  "contract_id": "KEFE-ACTION-TRACKING-001",
  "capability_id": "CAP-052",
  "status": "ACCEPTED",
  "invariants": {
    "milestone_verifiability_enforced": true,
    "objective_completion_criteria": true
  },
  "type": "object",
  "required": [
    "action_id",
    "institution_name",
    "pledge_title",
    "milestone_status",
    "completion_percentage",
    "target_completion_utc"
  ],
  "properties": {
    "action_id": {
      "type": "string",
      "minLength": 4
    },
    "institution_name": {
      "type": "string",
      "minLength": 3
    },
    "pledge_title": {
      "type": "string",
      "minLength": 5
    },
    "milestone_status": {
      "type": "string",
      "enum": [
        "PROMISED",
        "IN_PROGRESS",
        "DELIVERED_VERIFIED",
        "DELAYED_OR_BROKEN"
      ]
    },
    "completion_percentage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "target_completion_utc": {
      "type": "string",
      "format": "date-time"
    }
  }
}
