{
  "contract": "feed-item-normalization-slice54",
  "version": 1,
  "status": "accepted",
  "review_gate": {
    "required_decision": "ACCEPTED",
    "review_must_reference_proposal": true,
    "automatic_review": false,
    "direct_materializer_defense_in_depth": true
  },
  "proposal": {
    "kind": "FEED_ITEM",
    "payload_schema_ref": "kefe.feed-item",
    "payload_schema_version": "1.0.0",
    "risk_code": "UNREVIEWED_EXTERNAL_FEED_ITEM",
    "ai_execution_ref_allowed": false,
    "exact_payload_keys": [
      "feed_content_hash",
      "feed_format",
      "feed_storage_ref",
      "feed_title",
      "item_id",
      "item_title",
      "item_url",
      "published_at",
      "source_artifact_id",
      "summary_text"
    ]
  },
  "authority": {
    "source_artifact_loaded": true,
    "source_artifact_id_exact": true,
    "feed_content_hash_exact": true,
    "feed_storage_ref_exact": true,
    "proposal_provenance_ref_exact": true,
    "language_from_source_artifact": true,
    "jurisdiction_from_source_artifact": true,
    "proposal_may_override_source_authority": false
  },
  "target": {
    "target_kind": "NORMALIZED_ARTIFACT",
