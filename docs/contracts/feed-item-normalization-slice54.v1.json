    "max_item_title_chars": 4096,
    "max_feed_title_chars": 4096,
    "max_item_url_chars": 4096,
    "max_summary_chars": 16384,
    "max_reviewer_ref_chars": 512,
    "max_optional_review_field_chars": 4096,
    "utc_timestamp_required_when_present": true,
    "http_https_url_only": true,
    "url_userinfo_forbidden": true,
    "url_fragment_forbidden": true,
    "url_nonstandard_port_forbidden": true,
    "unknown_payload_fields_forbidden": true
