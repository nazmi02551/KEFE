    "argument": true,
    "case": true,
    "editorial_projection": true,
    "publication": true,
    "provider_activation": true,
    "scheduler_activation": true,
    "phone_surface": true
  },
  "composition": {
    "automatic_materialization_workers_registered": 0,
    "production_feed_providers_registered": 0,
    "production_feed_ingestion_plans_registered": 0
  },
  "required_ci": [
