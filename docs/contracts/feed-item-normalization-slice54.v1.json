  "provenance_metadata": {
    "bounded": true,
    "json_safe": true,
    "includes_proposal_id": true,
    "includes_review_id": true,
    "includes_reviewer_ref": true,
    "includes_source_artifact_id": true,
    "includes_feed_content_hash": true,
    "includes_feed_storage_ref": true,
    "includes_item_identity": true,
