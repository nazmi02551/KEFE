  "properties": {
    "campaign_id": {
      "type": "string",
      "minLength": 4
    },
    "ngo_name": {
      "type": "string",
      "minLength": 3
    },
    "advocacy_domain": {
      "type": "string",
      "enum": [
        "HUMAN_RIGHTS_AND_JUSTICE",
        "ENVIRONMENT_AND_CLIMATE",
        "PUBLIC_HEALTH_AND_SAFETY",
        "TRANSPARENCY_AND_ANTI_CORRUPTION"
      ]
    },
    "citizen_endorsement_count": {
      "type": "integer",
      "minimum": 0
    },
    "institutional_reforms_achieved": {
      "type": "integer",
      "minimum": 0
    },
    "advocacy_efficacy_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  }
}
