{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NgoImpactDeskContract",
  "version": "v1",
  "contract_id": "KEFE-NGO-DESK-001",
  "capability_id": "CAP-037",
  "status": "ACCEPTED",
  "invariants": {
    "zero_dark_money_foreign_funding_masking": true,
    "verifiable_advocacy_trail_enforced": true
  },
  "type": "object",
  "required": [
    "campaign_id",
    "ngo_name",
    "advocacy_domain",
    "citizen_endorsement_count",
    "institutional_reforms_achieved",
    "advocacy_efficacy_score"
