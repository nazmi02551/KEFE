{
  "contract": "source-acquisition-scheduler-slice40",
  "version": "1.0.0",
  "status": "accepted",
  "issue": 204,
  "parent_pr": 203,
  "capabilities": ["CAP-054", "CAP-055", "CAP-065"],
  "schedule": {
    "configuration_immutable": true,
    "key": "DETERMINISTIC",
    "states": ["ACTIVE", "PAUSED", "RETIRED"],
    "minimum_interval_seconds": 60,
    "maximum_interval_seconds": 2592000,
    "cadence": "UTC_FIXED_INTERVAL",
    "cron_supported": false,
    "timezone_local_supported": false,
    "minimum_dispatch_attempts": 1,
    "maximum_dispatch_attempts": 10
  },
  "planning": {
    "operation": "plan_due_once",
    "maximum_occurrences_per_call": 1,
    "oldest_first": true,
    "postgres_locking": "FOR_UPDATE_SKIP_LOCKED",
    "occurrence_key": ["schedule_id", "due_at"],
    "planning_and_advance_atomic": true,
    "next_due_basis": "PREVIOUS_DUE_PLUS_INTERVAL",
    "execution_time_drift": false,
    "invokes_adapter": false,
    "invokes_worker": false
  },
  "dispatch": {
    "states": [
      "PENDING",
      "RUNNING",
      "SUCCEEDED",
      "RETRYABLE_FAILURE",
      "FINAL_FAILURE",
      "BLOCKED"
    ],
    "operation": "execute_pending_once",
    "maximum_dispatches_per_call": 1,
    "oldest_first": true,
    "postgres_locking": "FOR_UPDATE_SKIP_LOCKED",
    "exclusive_owner": true,
    "bounded_claim_attempts": true,
    "heartbeat_requires_dispatch_and_worker": true
  },
  "stale_recovery": {
    "recover_before_claim": true,
    "attempts_remaining_state": "PENDING",
    "attempts_exhausted_state": "FINAL_FAILURE",
    "attempts_exhausted_error_code": "SOURCE_DISPATCH_ATTEMPTS_EXHAUSTED",
    "creates_artifact_or_run": false
  },
  "acquisition_guards": {
    "heartbeat_before_capture": true,
    "heartbeat_before_artifact_persist": true,
    "heartbeat_before_run_admission": true,
    "heartbeat_before_dispatch_completion": true,
    "expired_owner_completes_dispatch": false,
    "artifact_before_lost_run_admission_is_compensated": false,
    "replay_uses_slice39_idempotency": true
  },
  "completion": {
    "ADMITTED": "SUCCEEDED",
    "RETRYABLE_FAILURE": "RETRYABLE_FAILURE",
    "FINAL_FAILURE": "FINAL_FAILURE",
    "BLOCKED": "BLOCKED",
    "automatic_retry_backoff": false,
    "successful_result_fields": ["source_artifact_id", "ingestion_run_id"],
    "raw_payload_stored": false
  },
  "observer": {
    "observer_failure_changes_result": false,
    "allowed_fields": [
      "outcome",
      "worker_ref",
      "schedule_id",
      "dispatch_id",
      "due_at",
      "attempt_count",
      "source_artifact_id",
      "ingestion_run_id",
      "duration_ms",
      "error_code"
    ],
    "forbidden_fields": [
      "raw_text",
      "raw_body",
      "raw_bytes",
      "provider_response",
      "proposal_payload",
      "private_reason",
      "credential",
      "exception_text",
      "consumer_actor_id",
      "ideology",
      "personality",
      "psychometric",
      "bias_score",
      "causal_inference"
    ]
  },
  "composition": {
    "planner_exposed_in_application_state": true,
    "executor_exposed_in_application_state": true,
    "default_schedules": "NONE",
    "default_adapter_registry": "EMPTY",
    "continuous_loop": false
  },
  "exclusions": [
    "CRON_EXPRESSION",
    "TIMEZONE_LOCAL_CADENCE",
    "CONTINUOUS_DAEMON",
    "OS_PROCESS_MANAGER",
    "DEPLOYMENT_MANIFEST",
    "REAL_PROVIDER_ADAPTER",
    "NETWORK_REQUEST",
    "SCRAPING",
    "AI_CALL",
    "AUTOMATIC_SCHEDULE_CREATION",
    "AUTOMATIC_FAILURE_RETRY_BACKOFF",
    "INGESTION_WORKER_INVOCATION",
    "AUTOMATIC_PROPOSAL_REVIEW",
    "AUTOMATIC_EDITORIAL_PROJECTION",
    "AUTHORING_LIFECYCLE_TRANSITION",
    "ADMIN_HTTP_UI",
    "CASE_BUILDER",
    "FLOW_COMPOSER",
    "PHONE_BEHAVIOR"
  ],
  "required_evidence": [
    "REVERSIBLE_MIGRATION",
    "SCHEDULE_LIFECYCLE",
    "NO_DRIFT_PLANNING",
    "UNIQUE_OCCURRENCE",
    "POSTGRES_CONCURRENT_PLANNING",
    "POSTGRES_EXCLUSIVE_EXECUTION",
    "HEARTBEAT_OWNER_ENFORCEMENT",
    "STALE_RECOVERY",
    "ATTEMPT_EXHAUSTION",
    "ACQUISITION_PERSISTENCE_GUARDS",
    "LEASE_LOSS_NO_UNAUTHORIZED_COMPLETION",
    "CRASH_REPLAY_IDENTITY",
    "OBSERVER_ALLOWLIST",
    "EMPTY_PRODUCTION_CONFIGURATION",
    "MEMORY_POSTGRES_PARITY",
    "ARCHITECTURE_FITNESS",
    "EXACT_HEAD_API_CI",
    "EXACT_HEAD_MVP_BETA_GATES",
    "EXACT_HEAD_GLOBAL_READINESS"
  ]
}
