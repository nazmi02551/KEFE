{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DigitalSovereigntyVaultContract",
  "version": "v1",
  "contract_id": "KEFE-SOVEREIGNTY-001",
  "capability_id": "CAP-110",
  "status": "ACCEPTED",
  "invariants": {
    "zero_foreign_exfiltration_guaranteed": true,
    "cryptographic_jurisdictional_residency_enforced": true
  },
  "type": "object",
  "required": [
    "vault_id",
    "jurisdiction_region",
    "sovereignty_tier",
    "local_residency_pct",
    "exfiltration_threat_score"
  ],
  "properties": {
    "vault_id": {
      "type": "string",
      "minLength": 4
    },
    "jurisdiction_region": {
      "type": "string",
      "minLength": 2
    },
    "sovereignty_tier": {
      "type": "string",
      "enum": [
        "SOVEREIGN_RESIDENCY_ENFORCED",
        "CONTROLLED_EPHEMERAL_COMPUTE",
        "DATA_EXFILTRATION_BREACH_ALERT"
      ]
    },
    "local_residency_pct": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "exfiltration_threat_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  }
}
