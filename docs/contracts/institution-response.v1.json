{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InstitutionResponseContract",
  "version": "v1",
  "contract_id": "KEFE-INSTITUTION-RESPONSE-001",
  "capability_id": "CAP-050",
  "status": "ACCEPTED",
  "invariants": {
    "verified_authority_required": true,
    "immutable_timestamp": true,
    "traceable_follow_through": true
  },
  "type": "object",
  "required": [
    "response_id",
    "case_version_id",
    "institution_name",
    "authority_role",
    "verification_status",
    "response_type",
    "statement",
    "published_at"
  ],
  "properties": {
    "response_id": {
      "type": "string",
      "format": "uuid"
    },
    "case_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "institution_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 150
    },
    "authority_role": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "verification_status": {
      "type": "string",
      "enum": ["VERIFIED", "PENDING_VERIFICATION", "REJECTED"]
    },
    "response_type": {
      "type": "string",
      "enum": [
        "ACKNOWLEDGE",
        "COMMITMENT",
        "POLICY_CHANGE",
        "FACTUAL_CLARIFICATION",
        "DECLINE_WITH_REASON"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    },
    "milestone_date": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
