{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RightsConflictAnalyzerContract",
  "version": "v1",
  "contract_id": "KEFE-RIGHTS-CONFLICT-001",
  "capability_id": "CAP-024",
  "status": "ACCEPTED",
  "invariants": {
    "constitutional_rights_taxonomy": true,
    "core_essence_protection": true,
    "non_zero_sum_balancing": true
  },
  "type": "object",
  "required": [
    "case_version_id",
    "option_code",
    "collision_type",
    "severity",
    "inalienable_core_score",
    "constitutional_rationale"
  ],
  "properties": {
    "case_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "option_code": {
      "type": "string"
    },
    "collision_type": {
      "type": "string",
      "enum": [
        "PRIVACY_VS_SECURITY",
        "EXPRESSION_VS_DIGNITY",
        "PROPERTY_VS_ENVIRONMENT",
        "INDIVIDUAL_LIBERTY_VS_PUBLIC_HEALTH"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "PERMISSIBLE_RESTRICTION",
        "CORE_RIGHT_EROSION",
        "UNCONSTITUTIONAL_BREACH"
      ]
    },
    "inalienable_core_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "constitutional_rationale": {
      "type": "string",
      "minLength": 10
    }
  }
}
