{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VersionedDecisionReceiptContract",
  "version": "v1",
  "contract_id": "KEFE-DECISION-RECEIPT-001",
  "capability_id": "CAP-012",
  "status": "ACCEPTED",
  "invariants": {
    "cryptographic_integrity_digest_present": true,
    "timestamp_pinned_to_utc": true,
    "pre_commit_isolation_maintained": true
  },
  "type": "object",
  "required": [
    "receipt_id",
    "case_version_id",
    "committed_choice",
    "integrity_digest",
    "timestamp_utc"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "minLength": 8
    },
    "case_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "committed_choice": {
      "type": "string",
      "minLength": 1
    },
    "integrity_digest": {
      "type": "string",
      "minLength": 16
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    }
  }
}
