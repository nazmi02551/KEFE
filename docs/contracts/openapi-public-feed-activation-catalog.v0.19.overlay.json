      "get": {
        "operationId": "list_public_feed_activations_internal_admin_v1_public_feed_activations_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "after_activation_code",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "minLength": 4,
                  "pattern": "^[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9][a-z0-9_-]*)*\\.v[1-9][0-9]*$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "After Activation Code"
            }
          }
        ],
