{
  "contract_id": "KEFE-OTP-SECRET-RESOLUTION-001",
  "contract_version": "1.0.0",
  "foundation_wave": "F4",
  "capabilities": ["CAP-084"],
  "purpose": "Keep production OTP provider credentials out of long-lived application configuration and resolve a bounded secret lease for each logical delivery.",
  "production_configuration": {
    "delivery_mode": "HTTP",
    "credential_input": "KEFE_OTP_HTTP_SECRET_REF",
    "direct_bearer_token_forbidden": true,
    "default_reference_scheme": "envref",
    "reference_is_secret": true,
    "reference_is_never_exposed": true
  },
  "resolution": {
    "frequency": "ONCE_PER_LOGICAL_SEND",
    "transport_retries_reuse_resolution": true,
    "lease_ttl_seconds": {
      "default": 30,
      "minimum": 1,
      "maximum": 300
    },
    "lease_closed_in_finally": true,
    "lease_material_zeroed_on_close": true,
    "rotation_requires_process_restart": false,
    "provider_called_on_resolution_failure": false
  },
  "failure_mapping": {
    "retryable_resolution": {
      "public_error": "AUTH_OTP_DELIVERY_UNAVAILABLE",
      "operational_code": "OTP_SECRET_RESOLUTION_RETRYABLE"
    },
    "final_resolution": {
      "public_error": "AUTH_OTP_DELIVERY_REJECTED",
      "operational_code": "OTP_SECRET_RESOLUTION_FINAL"
    },
    "unexpected_resolution": {
      "public_error": "AUTH_OTP_DELIVERY_REJECTED",
      "operational_code": "OTP_SECRET_RESOLUTION_UNEXPECTED"
    },
    "invalid_material": {
      "public_error": "AUTH_OTP_DELIVERY_REJECTED",
      "operational_code": "OTP_SECRET_MATERIAL_INVALID"
    }
  },
  "privacy": {
    "forbidden_in_logs_events_exceptions_admin": [
      "secret_material",
      "secret_reference",
      "recipient",
      "otp_code",
      "provider_request_body",
      "provider_response_body"
    ],
    "resolver_repr_redacted": true,
    "delivery_repr_redacted": true,
    "operational_dimensions_bounded": true
  },
  "compatibility": {
    "capture_mode_nonproduction_only": true,
    "direct_secret_nonproduction_only": true,
    "public_api_changed": false,
    "openapi_drift_allowed": false,
    "database_migration_required": false
  },
  "external_non_claims": [
    "REAL_SECRET_MANAGER_CONNECTED",
    "REAL_PROVIDER_CREDENTIAL_CONFIGURED",
    "REAL_EMAIL_OR_SMS_DELIVERED",
    "OPERATOR_ROTATION_DRILL_EXECUTED",
    "DEPLOYED_SECRET_ACCESS_SLO_VERIFIED"
  ]
}
