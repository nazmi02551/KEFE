{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CivicAuditProofRepositoryContract",
  "version": "v1",
  "contract_id": "KEFE-AUDIT-REPO-001",
  "capability_id": "CAP-107",
  "status": "ACCEPTED",
  "invariants": {
    "content_addressed_immutability_enforced": true,
    "multi_peer_attestation_mandated": true
  },
  "type": "object",
  "required": [
    "report_id",
    "investigation_title",
    "verification_status",
    "peer_attestation_signatures_count",
    "evidentiary_rigor_score",
    "content_hash_digest"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "minLength": 4
    },
    "investigation_title": {
      "type": "string",
      "minLength": 6
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "PEER_ATTESTED_CORROBORATED",
        "OPEN_EVIDENTIARY_CHALLENGE",
        "PENDING_WITNESS_CONFIRMATION"
      ]
    },
    "peer_attestation_signatures_count": {
      "type": "integer",
      "minimum": 0
    },
    "evidentiary_rigor_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "content_hash_digest": {
      "type": "string",
      "minLength": 16
    }
  }
}
