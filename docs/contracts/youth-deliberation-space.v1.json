        "CAMPUS_AND_EDUCATION_POLICY",
        "CLIMATE_AND_INTERGENERATIONAL",
        "DIGITAL_RIGHTS_AND_AI",
        "CIVIC_ENTREPRENEURSHIP"
      ]
    },
    "institution_or_community": {
      "type": "string",
      "minLength": 3
    },
    "active_student_count": {
      "type": "integer",
      "minimum": 0
    },
    "consensus_action_count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
