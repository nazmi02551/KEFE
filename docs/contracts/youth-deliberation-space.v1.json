{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YouthDeliberationSpaceContract",
  "version": "v1",
  "contract_id": "KEFE-YOUTH-SPACE-001",
  "capability_id": "CAP-032",
  "status": "ACCEPTED",
  "invariants": {
    "zero_commercial_ad_targeting": true,
    "enhanced_moderation_guard": true
