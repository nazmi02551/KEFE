{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThresholdSensitivityAnalysisContract",
  "version": "v1",
  "contract_id": "KEFE-THRESHOLD-SENSITIVITY-001",
  "capability_id": "CAP-018",
  "status": "ACCEPTED",
  "invariants": {
