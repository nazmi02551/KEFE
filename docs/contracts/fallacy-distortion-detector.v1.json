{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FallacyDistortionDetectorContract",
  "version": "v1",
  "contract_id": "KEFE-FALLACY-DETECTOR-001",
  "capability_id": "CAP-042",
  "status": "ACCEPTED",
  "invariants": {
    "standard_fallacy_taxonomy": true,
    "pedagogical_non_punitive_guidance": true,
    "neutral_logical_adjudication": true
  },
  "type": "object",
  "required": [
    "argument_id",
    "detected_fallacies",
    "has_fallacy",
    "overall_integrity_score"
  ],
  "properties": {
    "argument_id": {
      "type": "string",
      "format": "uuid"
    },
    "has_fallacy": {
      "type": "boolean"
    },
    "overall_integrity_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "detected_fallacies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fallacy_type",
          "confidence",
          "explanation"
        ],
        "properties": {
          "fallacy_type": {
            "type": "string",
            "enum": [
              "AD_HOMINEM",
              "STRAW_MAN",
              "FALSE_DILEMMA",
              "SLIPPERY_SLOPE",
              "APPEAL_TO_EMOTION_FEAR",
              "NO_FALLACY_DETECTED"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "explanation": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  }
}
