          "rank"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "format": "uuid"
          },
          "version_id": {
            "type": "string",
            "format": "uuid"
          },
          "placement": {
            "type": "string"
          },
          "rank": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "case.opened": {
      "event_version": 1,
      "payload_schema": {
        "type": "object",
