{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KEFE Event Contract Registry v1.0.0",
  "registry_version": "1.0.0",
  "envelope": {
    "type": "object",
    "required": [
      "event_id",
      "event_name",
      "event_version",
      "occurred_at",
      "producer_version",
      "payload"
    ],
    "properties": {
      "event_id": {
        "type": "string",
        "format": "uuid"
      },
      "event_name": {
        "type": "string"
      },
      "event_version": {
        "type": "integer",
        "minimum": 1
      },
      "occurred_at": {
        "type": "string",
        "format": "date-time"
      },
      "producer_version": {
        "type": "string"
      },
      "trace_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "actor_id": {
        "type": [
          "string",
          "null"
        ],
        "format": "uuid"
      },
      "session_id": {
        "type": [
          "string",
          "null"
        ],
        "format": "uuid"
      },
      "payload": {
        "type": "object"
      }
    },
    "additionalProperties": false
  },
  "events": {
    "case.impression": {
      "event_version": 1,
      "payload_schema": {
        "type": "object",
