        ],
        "properties": {
          "case_id": {
            "type": "string",
            "format": "uuid"
          },
          "version_id": {
            "type": "string",
            "format": "uuid"
          },
          "entry_point": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "case.viewed": {
