    "weigh.committed": {
      "event_version": 1,
      "payload_schema": {
        "type": "object",
        "required": [
          "session_id",
          "case_version_id",
          "journey_stage",
          "depth"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "case_version_id": {
            "type": "string",
            "format": "uuid"
          },
